# Everything environment-specific lives here and only here.
# Copy to .env and fill in. Never commit .env.
# Values in .env replace anything already set in your shell; the tool ignores
# GH_TOKEN, SENTRY_*, ANTHROPIC_API_KEY etc. from anywhere else.

# GitHub token (fine-grained: Contents, Issues, Pull requests: RW; Metadata: R)
GH_TOKEN=

# Sentry
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_API_BASE=https://sentry.io/api/0

# Which Sentry projects feed which GitHub repos.
# Comma-separated sentry-project-slug=owner/repo pairs, e.g.
# AUTOFIX_PROJECTS=billing-api=myorg/billing-api,web-app=myorg/web-app
# If a repo holds several projects' code, add :path for the project's folder:
# AUTOFIX_PROJECTS=fn-a=myorg/backend:lambdas/a,fn-b=myorg/backend:lambdas/b
AUTOFIX_PROJECTS=

# Claude: set exactly one of these three options.
# Option 1: Anthropic API key from console.anthropic.com > API keys
# (starts with sk-ant-; OpenAI keys won't work)
ANTHROPIC_API_KEY=
# Option 2: Amazon Bedrock (uses the machine's AWS credentials / instance IAM role)
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# Option 3: Claude Code's own sign-in (run `claude` and /login once as this user).
# Good for testing on a laptop with your Claude plan; not for the unattended server.
# AUTOFIX_CLAUDE_LOGIN=1
